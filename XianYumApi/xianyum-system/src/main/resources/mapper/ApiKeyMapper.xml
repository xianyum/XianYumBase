<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.xianyum.system.dao.ApiKeyMapper">

    <update id="increaseTotalCount">
        UPDATE api_key
        SET total_request_count = total_request_count + #{count}
        WHERE api_key = #{apiKey}
    </update>

</mapper>
