<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.xianyum.system.dao.UserOnlineMapper">

    <sql id="userOnlineColumns">
        id,
        token,
        username,
        login_time,
        ipaddr,
        login_location,
        browser,
        os,
        login_type,
        expire_time,
        create_by,
        create_time,
        create_by_name,
        update_by,
        update_time,
        update_by_name
    </sql>

    <select id="selectByToken" resultType="cn.xianyum.system.entity.po.UserOnlineEntity">
        SELECT
        <include refid="userOnlineColumns"/>
        FROM user_online
        WHERE token = #{token}
    </select>

    <delete id="deleteByToken">
        DELETE FROM user_online WHERE token = #{token}
    </delete>

    <delete id="deleteExpired">
        DELETE FROM user_online WHERE expire_time IS NOT NULL AND expire_time &lt; NOW()
    </delete>

    <delete id="deleteByTokens">
        DELETE FROM user_online WHERE token IN
        <foreach collection="tokens" item="token" open="(" separator="," close=")">
            #{token}
        </foreach>
    </delete>

</mapper>
